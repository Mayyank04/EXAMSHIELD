# ==============================================================================
# EXAMSHIELD ENVIRONMENT VARIABLES & CONFIGURATION
# Sovereign AI-Powered Examination Paper Security & Integrity Platform
# ==============================================================================

# Node Environment ('development' or 'production')
NODE_ENV=development
PORT=3001

# Application Branding
VITE_APP_NAME="ExamShield Sovereign Examination Security"
VITE_SECURITY_TIER="NATIONAL_DEFENSE"

# ------------------------------------------------------------------------------
# Provider Integration Keys (Optional: Leave empty to use in-memory Demo Provider)
# ------------------------------------------------------------------------------

# Google Gemini Threat Engine API Key
GEMINI_API_KEY=

# OpenAI NLP Extractor API Key
OPENAI_API_KEY=

# Google Maps Platform Vector JavaScript API Key (Leaflet is used as standard fallback)
GOOGLE_MAPS_API_KEY=

# Ethereum / EVM Blockchain RPC URL for Smart Contract Audit Anchoring
ETHEREUM_RPC_URL=

# IoT MQTT Telemetry Broker Endpoint (e.g. mqtts://iot.examshield.gov.in:8883)
MQTT_BROKER_URL=

# Zero-Trust IAM Secret Key (for signing session tokens and RSA-2048 metadata)
AUTH_SECRET=examshield_sovereign_secret_key_change_in_production
